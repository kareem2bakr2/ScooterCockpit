<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCockpit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">
    <SurfaceView
        android:id="@+id/camPreview"
        android:layout_width="1dp"
        android:layout_height="1dp" />

    <!-- TOP STATUS BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <!-- Left Status Group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTurnLeft"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="⬅"
                android:textColor="#00E676"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHighBeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="≡D"
                android:textColor="#3B82F6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ESP32 Status Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginLeft="14dp"
                android:background="@drawable/bg_esp_linked"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <TextView
                    android:id="@+id/tvEspDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● "
                    android:textColor="#00E676"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvEspStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESP32: LINKED"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvScooterVolt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="🔋 13.8V"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTabletBatt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="▯ 88%"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:text="21:15"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Controls Group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Day/Night Segmented Toggle Pill -->
            <LinearLayout
                android:id="@+id/btnDayNight"
                android:layout_width="76dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_toggle_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tvSunIcon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="☀"
                    android:textColor="#8B949E"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvMoonIcon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dock_active"
                    android:gravity="center"
                    android:text="☾"
                    android:textColor="#00E5FF"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginLeft="14dp"
                android:background="@android:color/transparent"
                android:text="⚙"
                android:textColor="#94A3B8"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvTurnRight"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="10dp"
                android:gravity="center"
                android:text="➡"
                android:textColor="#00E676"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- SUBTLE TOP HORIZONTAL DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2530" />

    <!-- MAIN WORKSPACE: LEFT DOCK + CENTER CLUSTER + RIGHT CARDS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- COLUMN 1: LEFT THUMB NAVIGATION DOCK -->
        <LinearLayout
            android:layout_width="108dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp">

            <Button
                android:id="@+id/btnDockRide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_active"
                android:text="⏱&#10;RIDE"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDockNavi"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_normal"
                android:text="⌖&#10;NAVI"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDockMusic"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_normal"
                android:text="♫&#10;MUSIC"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDockBt"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_normal"
                android:text="ᛒ&#10;BT"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDockApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_normal"
                android:text="⊞&#10;APPS"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- VERTICAL SEPARATOR -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1E2530" />

        <!-- COLUMN 2: CENTER PANEL CONTAINER -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingBottom="10dp"
            android:paddingLeft="14dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp">

            <!-- PANEL 1: MAIN RIDE TELEMETRY -->
            <LinearLayout
                android:id="@+id/panelRide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="ENGINE SPEED"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- RPM Arc + Nested Readout -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="168dp">

                    <com.scooter.cockpit.RpmArcView
                        android:id="@+id/rpmArcView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRpm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6,400"
                            android:textColor="#00E5FF"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RPM"
                            android:textColor="#8B949E"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Middle Row: Speed Limit Sign | Speedometer | Drive/Gear Box -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp">

                    <!-- Left: Speed Limit Sign -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSpeedLimit"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_speed_limit"
                            android:gravity="center"
                            android:text="80"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="LIMIT"
                            android:textColor="#8B949E"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Center Hero Speed -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="68"
                            android:textColor="#FFFFFF"
                            android:textSize="92sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KM/H"
                            android:textColor="#8B949E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Right: Gear / Drive Indicator Box -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGear"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_gear_box"
                            android:gravity="center"
                            android:text="D"
                            android:textColor="#FFFFFF"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="DRIVE"
                            android:textColor="#8B949E"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Hairline Divider + ABS / TCS / Ambient Temp -->
                <View
                    android:layout_width="240dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:background="#1E2530" />

                <TextView
                    android:id="@+id/tvAssistStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="6dp"
                    android:text="● ABS   •   TCS ON   •   24°C"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Bottom 3-Column Telemetry Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:background="@drawable/bg_card_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp">

                    <!-- Trip A -->
                    <LinearLayout
                        android:id="@+id/boxTripA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRIP A"
                            android:textColor="#8B949E"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTripA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42.6"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"
                                android:text="km"
                                android:textColor="#8B949E"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="38dp"
                        android:layout_marginRight="14dp"
                        android:background="#232A35" />

                    <!-- Odometer -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.15"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ODOMETER"
                            android:textColor="#8B949E"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvOdo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8,426"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"
                                android:text="km"
                                android:textColor="#8B949E"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="38dp"
                        android:layout_marginRight="14dp"
                        android:background="#232A35" />

                    <!-- Avg Speed -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVG. SPEED"
                            android:textColor="#8B949E"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvAvgSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="46"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"
                                android:text="km/h"
                                android:textColor="#8B949E"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- PANEL 2: IN-APP NAVIGATION (Shown when btnDockNavi is pressed) -->
            <LinearLayout
                android:id="@+id/panelNavi"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="gone">

                <!-- Destination Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etDestination"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#0B0F17"
                        android:hint="Destination or lat, lng"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnSearchDest"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_dock_active"
                        android:text="GO"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRecenterMap"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_dock_normal"
                        android:text="⌖"
                        android:textColor="#E2E8F0"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Embedded OpenStreetMap View -->
                <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>

        <!-- COLUMN 3: RIGHT TELEMETRY STACK (4 CARDS) -->
        <LinearLayout
            android:layout_width="236dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:paddingLeft="6dp"
            android:paddingRight="12dp"
            android:paddingTop="10dp">

            <!-- CARD 1: FUEL / RANGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.55"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛽  FUEL / RANGE"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFuelRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="186"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="km"
                            android:textColor="#8B949E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="→"
                        android:textColor="#8B949E"
                        android:textSize="18sp" />
                </RelativeLayout>

                <com.scooter.cockpit.FuelBarView
                    android:id="@+id/fuelBarView"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvFuelPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:text="64%"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFuelLiters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:text="7.8 L"
                        android:textColor="#8B949E"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- CARD 2: COOLANT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌡  COOLANT"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCoolantTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="84°"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:text="C"
                            android:textColor="#8B949E"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCoolantStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="NORMAL"
                        android:textColor="#00E676"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <!-- CARD 3: RIDING MODE -->
            <LinearLayout
                android:id="@+id/cardRidingMode"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_riding_mode"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIDING MODE"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvRidingMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:text="SPORT"
                        android:textColor="#00E5FF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="›"
                        android:textColor="#00E5FF"
                        android:textSize="22sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- CARD 4: RIDE TIME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIDE TIME"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvRideTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:text="00:54"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="⏱"
                        android:textColor="#8B949E"
                        android:textSize="18sp" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>